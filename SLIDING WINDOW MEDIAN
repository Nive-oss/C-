#include <vector>
#include <set>

using namespace std;

class Solution {
    multiset<long> low, high;

    // Balance the sets so low has k/2 + k%2 elements and high has k/2
    void balance() {
        if (low.size() > high.size() + 1) {
            high.insert(*low.rbegin());
            low.erase(prev(low.end()));
        } else if (high.size() > low.size()) {
            low.insert(*high.begin());
            high.erase(high.begin());
        }
    }

public:
    vector<double> medianSlidingWindow(vector<int>& nums, int k) {
        vector<double> result;
        
        for (int i = 0; i < nums.size(); i++) {
            // 1. Insert new element
            if (low.empty() || nums[i] <= *low.rbegin()) {
                low.insert(nums[i]);
            } else {
                high.insert(nums[i]);
            }
            balance();

            // 2. Remove old element from the window
            if (i >= k) {
                int out = nums[i - k];
                auto it = low.find(out);
                if (it != low.end()) {
                    low.erase(it);
                } else {
                    high.erase(high.find(out));
                }
                balance();
            }

            // 3. Calculate median
            if (i >= k - 1) {
                if (k % 2 == 1) {
                    result.push_back((double)*low.rbegin());
                } else {
                    // Use long long/double to prevent overflow during addition
                    result.push_back(((double)*low.rbegin() + (double)*high.begin()) / 2.0);
                }
            }
        }
        
        return result;
    }
};
